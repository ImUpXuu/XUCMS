<?xml version="1.0" encoding="utf-8"?>
<!--
  Local data must survive an app update, a device transfer and a cloud restore:
  drafts are the user's unpublished writing and settings hold the server address.

  Only listed paths are backed up, so the admin key stays out of cloud backup by
  being absent rather than by an explicit <exclude>, which lint rejects outside an
  included path. Device transfer is a direct phone-to-phone handoff, so the key
  goes along there and the user does not have to sign in again.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="drafts" />
        <include domain="sharedpref" path="xucms_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="drafts" />
        <include domain="sharedpref" path="xucms_settings.xml" />
        <include domain="sharedpref" path="xucms_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
