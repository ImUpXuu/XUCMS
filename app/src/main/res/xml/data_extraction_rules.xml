<?xml version="1.0" encoding="utf-8"?>
<!--
  Local data must survive an app update, a device transfer and a cloud restore:
  drafts are the user's unpublished writing and settings hold the server address.
  The admin key is deliberately excluded — a secret should not ride along in a
  cloud backup, so the user re-enters it once after a restore.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="drafts" />
        <include domain="sharedpref" path="xucms_settings.xml" />
        <exclude domain="sharedpref" path="xucms_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="drafts" />
        <include domain="sharedpref" path="xucms_settings.xml" />
        <include domain="sharedpref" path="xucms_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
